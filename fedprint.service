[Unit]
Description=FedPrint local network printing portal
Documentation=file:///opt/fedprint/README.md
After=network-online.target cups.service
Wants=network-online.target
Requires=cups.service

[Service]
Type=simple
# Run as a dedicated non-root user that is a member of the "lp" group.
# See the README "systemd service" section for setup instructions.
User=fedprint
Group=lp
WorkingDirectory=/opt/fedprint
EnvironmentFile=-/opt/fedprint/.env
ExecStart=/usr/bin/node /opt/fedprint/dist/server.js
Restart=on-failure
RestartSec=3

# Hardening. The app only needs to read its own files and write uploads/.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/fedprint/uploads

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
