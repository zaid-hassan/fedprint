# FedPrint configuration
# Copy to .env and adjust as needed.

# CUPS queue name of the printer (must already exist in CUPS).
PRINTER_NAME=DCPT230

# HTTP server
PORT=27183
HOST=0.0.0.0

# Maximum upload size in megabytes.
MAX_UPLOAD_MB=25

# Directory for temporary uploads (created if missing).
UPLOAD_DIR=./uploads

# mDNS discovery: auto | true | false
# auto publishes fedprint.local only when avahi-publish is available.
MDNS_ENABLED=auto

# Log level: debug | info | warn | error
LOG_LEVEL=info
